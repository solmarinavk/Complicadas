# Copia este archivo como ".env" para pruebas locales con "netlify dev".
# NUNCA subas tu .env real al repositorio.

# --- Obligatoria ---
# Tu clave secreta de OpenAI (empieza con sk-...)
OPENAI_API_KEY=sk-tu-clave-aqui

# --- Opcionales (tienen valores por defecto economicos) ---
# Modelo de chat
OPENAI_MODEL=gpt-4o-mini
# Modelo de transcripcion (voz -> texto)
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# Modelo de voz (texto -> voz)
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Voz hablada: marin, alloy, ash, ballad, coral, echo, nova, sage, shimmer...
OPENAI_TTS_VOICE=marin
# Limite de longitud de respuesta (tokens). Mas bajo = mas barato.
OPENAI_MAX_TOKENS=500
